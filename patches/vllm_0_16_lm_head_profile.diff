+    def _lm_head_profile_tic(self) -> float | None:
+        if not self.lm_head_profile_enabled:
+            return None
+        if torch.cuda.is_available() and self.device.type == "cuda":
+            torch.cuda.synchronize(self.device)
+        return time.perf_counter()
+
+    def _lm_head_profile_record_ms(
+        self, key: str, start_time: float | None
+    ) -> None:
+        if start_time is None or self.lm_head_profile_current is None:
+            return
+        if torch.cuda.is_available() and self.device.type == "cuda":
+            torch.cuda.synchronize(self.device)
+        elapsed_ms = (time.perf_counter() - start_time) * 1000.0
+        self.lm_head_profile_current[key] = (
+            self.lm_head_profile_current.get(key, 0.0) + elapsed_ms
+        )
+
+    def _lm_head_profile_start_step(
+        self,
+        scheduler_output: "SchedulerOutput",
+        num_scheduled_tokens_np: np.ndarray,
+        step_start_time: float | None,
+    ) -> dict[str, Any] | None:
+        if not self.lm_head_profile_enabled:
+            return None
+
+        scheduled_tokens = [int(x) for x in num_scheduled_tokens_np.tolist()]
+        num_decode_reqs = sum(1 for x in scheduled_tokens if x == 1)
+        num_prefill_reqs = len(scheduled_tokens) - num_decode_reqs
+        if num_prefill_reqs and num_decode_reqs:
+            phase = "mixed"
+        elif num_prefill_reqs:
+            phase = "prefill"
+        else:
+            phase = "decode"
+
+        self.lm_head_profile_step += 1
+        record: dict[str, Any] = {
+            "pid": os.getpid(),
+            "step": self.lm_head_profile_step,
+            "phase": phase,
+            "num_reqs": len(scheduled_tokens),
+            "num_scheduled_tokens": int(scheduler_output.total_num_scheduled_tokens),
+            "num_prefill_reqs": num_prefill_reqs,
+            "num_decode_reqs": num_decode_reqs,
+            "max_scheduled_tokens": max(scheduled_tokens) if scheduled_tokens else 0,
+            "sample_rows": 0,
+            "logits_rows": 0,
+            "forward_ms": 0.0,
+            "logits_ms": 0.0,
+            "grammar_ms": 0.0,
+            "sample_ms": 0.0,
+            "bookkeeping_ms": 0.0,
+            "step_ms": 0.0,
+            "_step_start_time": step_start_time,
+        }
+        self.lm_head_profile_current = record
+        return record
+
+    def _lm_head_profile_compute_logits(
+        self, hidden_states: torch.Tensor
+    ) -> torch.Tensor | None:
+        start_time = self._lm_head_profile_tic()
+        logits = self.model.compute_logits(hidden_states)
+        self._lm_head_profile_record_ms("logits_ms", start_time)
+        if self.lm_head_profile_current is not None:
+            self.lm_head_profile_current["logits_rows"] += int(hidden_states.shape[0])
+        return logits
+
+    def _lm_head_profile_finish_step(self) -> None:
+        if not self.lm_head_profile_enabled:
+            return
+        record = self.lm_head_profile_active or self.lm_head_profile_current
+        if record is None:
+            return
+        if not is_global_first_rank():
+            self.lm_head_profile_current = None
+            self.lm_head_profile_active = None
+            return
+
+        self.lm_head_profile_current = record
+        self._lm_head_profile_record_ms(
+            "step_ms", record.pop("_step_start_time", None)
+        )
+
+        forward_ms = float(record.get("forward_ms", 0.0))
+        logits_ms = float(record.get("logits_ms", 0.0))
+        grammar_ms = float(record.get("grammar_ms", 0.0))
+        sample_ms = float(record.get("sample_ms", 0.0))
+        bookkeeping_ms = float(record.get("bookkeeping_ms", 0.0))
+        core_ms = forward_ms + logits_ms + grammar_ms + sample_ms
+        model_logits_ms = forward_ms + logits_ms
+        runner_ms = core_ms + bookkeeping_ms
+        record["core_ms"] = core_ms
+        record["model_logits_ms"] = model_logits_ms
+        record["runner_accounted_ms"] = runner_ms
+        record["lm_head_share_model_logits"] = (
+            logits_ms / model_logits_ms if model_logits_ms > 0 else 0.0
+        )
+        record["lm_head_share_core"] = logits_ms / core_ms if core_ms > 0 else 0.0
+        record["lm_head_share_step"] = (
+            logits_ms / float(record["step_ms"])
+            if float(record["step_ms"]) > 0
+            else 0.0
+        )
+
+        if self.lm_head_profile_path:
+            parent_dir = os.path.dirname(self.lm_head_profile_path)
+            if parent_dir:
+                os.makedirs(parent_dir, exist_ok=True)
+            with open(self.lm_head_profile_path, "a", encoding="utf-8") as profile_f:
+                profile_f.write(json.dumps(record, sort_keys=True) + "\n")
+        elif self.lm_head_profile_step % self.lm_head_profile_log_every == 0:
+            logger.info(
+                "LM head profile step=%d phase=%s forward=%.3fms logits=%.3fms "
+                "sample=%.3fms lm_share_core=%.3f",
+                record["step"],
+                record["phase"],
+                forward_ms,
+                logits_ms,
+                sample_ms,
+                record["lm_head_share_core"],
+            )
+
+        self.lm_head_profile_current = None
+        self.lm_head_profile_active = None
+
